# ==============================================================================
# TECHX CTF 2026 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & DEPLOYMENT MODE
# ------------------------------------------------------------------------------
# Options: 'development', 'production', 'test'
NODE_ENV=development

# Deployment target: 'lan' (College LAN/Laptop offline mode) or 'production' (Cloud VPS)
DEPLOYMENT_MODE=lan

# Host address and port the backend listens on internally
APP_HOST=0.0.0.0
APP_PORT=4000

# Public-facing domain or IP address used by participants
# - In College LAN mode: Set to host machine's LAN Ethernet IP (e.g. 192.168.1.50) or mDNS host (techx-ctf.local)
# - In Production mode: Set to public domain (e.g. ctf.techxmadras.org)
PUBLIC_HOST=192.168.1.50
PUBLIC_PORT=80
PUBLIC_PROTOCOL=http

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://192.168.1.50,http://localhost,http://127.0.0.1,http://techx-ctf.local

# JWT Secret for signing participant/admin session tokens (Use >= 32 random characters in production!)
JWT_SECRET=super_secret_jwt_key_techx_ctf_change_me_in_production_32chars!
JWT_EXPIRES_IN=24h

# Session cookie secret for Fastify cookie signing
COOKIE_SECRET=super_secret_cookie_signing_key_techx_ctf_32chars_minimum!

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL 16)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=techx_ctf_user
DB_PASSWORD=techx_ctf_secure_password_2026
DB_NAME=techx_ctf_db
DATABASE_URL=postgresql://techx_ctf_user:techx_ctf_secure_password_2026@postgres:5432/techx_ctf_db
DB_POOL_MIN=5
DB_POOL_MAX=30

# ------------------------------------------------------------------------------
# 4. CACHE & REAL-TIME EVENT BUS (REDIS 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=techx_redis_secure_password_2026
REDIS_URL=redis://:techx_redis_secure_password_2026@redis:6379/0

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & PROTECTION
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
FLAG_SUBMIT_LIMIT_PER_WINDOW=5
FLAG_SUBMIT_WINDOW_MS=30000

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Options: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. COMPETITION RULES & FLAGS
# ------------------------------------------------------------------------------
TEAM_MAX_MEMBERS=4
COMPETITION_STATE=active
FLAG_PREFIX=TECHX{
FLAG_SALT=techx_ctf_2026_super_secret_flag_salt
