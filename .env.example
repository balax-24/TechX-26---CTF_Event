# ==============================================================================
# TECHX CTF 2026 — PRODUCTION & EVENT ENVIRONMENT TEMPLATE
# ==============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT.
# To generate a production configuration with cryptographically secure secrets:
#   chmod +x ./scripts/generate_secrets.sh && ./scripts/generate_secrets.sh
# Or manually copy this template and replace all <PLACEHOLDERS>:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# PART A: SAFE OPERATIONAL CONFIGURATION (Non-Sensitive)
# ==============================================================================

# 1. RUNTIME & DEPLOYMENT TARGET
# Options: 'development', 'production', 'test'
NODE_ENV=production

# Target mode: 'lan' (College LAN/Laptop offline mode) or 'production' (Cloud VPS)
DEPLOYMENT_MODE=lan

# Host address and port the Fastify backend binds to internally
APP_HOST=0.0.0.0
APP_PORT=4000

# Public-facing domain or IP address used by participants
# - LAN Mode: Set to event server's Ethernet IP (e.g. 192.168.1.50) or mDNS host (techx-ctf.local)
# - VPS Mode: Set to domain name (e.g. ctf.techxmadras.org)
PUBLIC_HOST=192.168.1.50
PUBLIC_PORT=80
PUBLIC_PROTOCOL=http

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://192.168.1.50,http://localhost,http://127.0.0.1,http://techx-ctf.local

# 2. INTERNAL TOPOLOGY (Service discovery within Docker network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=techx_ctf_user
DB_NAME=techx_ctf_db
DB_POOL_MIN=5
DB_POOL_MAX=25

REDIS_HOST=redis
REDIS_PORT=6379

CHALLENGE_GATEWAY_URL=http://challenge_gateway:5000

# 3. RATE LIMITING & SECURITY THRESHOLDS
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
FLAG_SUBMIT_LIMIT_PER_WINDOW=5
FLAG_SUBMIT_WINDOW_MS=30000

# 4. LOGGING & OBSERVABILITY
# Options: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# 5. COMPETITION RULES & POLICIES
TEAM_MAX_MEMBERS=4
COMPETITION_STATE=active
FLAG_PREFIX=TECHX{
JWT_EXPIRES_IN=24h

# 6. DYNAMIC CHALLENGE DOCKER LIMITS (Enforced strictly by Challenge Gateway)
DOCKER_CONTAINER_CPU_LIMIT=0.5
DOCKER_CONTAINER_MEMORY_LIMIT=256m
DOCKER_CONTAINER_PIDS_LIMIT=64
MAX_INSTANCES_PER_TEAM=2
MAX_GLOBAL_INSTANCES=100

# ==============================================================================
# PART B: SECRETS & CRYPTOGRAPHIC KEYS (Must be >= 32 hex chars in production)
# ==============================================================================
# [CRITICAL] Never commit real secrets. Fail-fast validation will abort startup
# if default values are used when NODE_ENV=production.

# Session JWT Signing Secret (Minimum 32 random characters)
JWT_SECRET=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_MIN_32_CHARS>

# Session Cookie Signing Secret (Minimum 32 random characters)
COOKIE_SECRET=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_MIN_32_CHARS>

# Challenge Gateway Authentication Secret (Minimum 32 random characters)
CHALLENGE_GATEWAY_SECRET=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_MIN_32_CHARS>

# Flag Hashing Salt (Minimum 16 random characters)
FLAG_SALT=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_MIN_16_CHARS>

# PostgreSQL Database Master Password
DB_PASSWORD=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_STRONG_PASSWORD>

# Full Database Connection URL
DATABASE_URL=postgresql://techx_ctf_user:${DB_PASSWORD}@postgres:5432/techx_ctf_db

# Redis Authentication Password
REDIS_PASSWORD=<GENERATE_WITH_SCRIPTS_GENERATE_SECRETS_SH_STRONG_PASSWORD>

# Full Redis Connection URL
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==============================================================================
# PART C: INITIAL ADMINISTRATOR BOOTSTRAP (For 'npm run bootstrap:admin')
# ==============================================================================
# Used only during initial provisioning. Remove from environment after bootstrap.
ADMIN_USERNAME=techx_admin
ADMIN_EMAIL=admin@techxmadras.org
ADMIN_PASSWORD=<SET_STRONG_ADMIN_PASSWORD_MIN_12_CHARS>
