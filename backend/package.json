{
  "name": "techx-ctf-backend",
  "version": "1.0.0",
  "description": "Production-grade CTF Platform Core Engine for TechX Madras 2026",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "bootstrap:admin": "node dist/scripts/bootstrap_admin.js",
    "bootstrap:admin:dev": "tsx src/scripts/bootstrap_admin.ts",
    "admin:provision-team": "node dist/scripts/provision_team.js",
    "admin:provision-team:dev": "tsx src/scripts/provision_team.ts",
    "admin:cleanup-test-team": "node dist/scripts/cleanup_test_team.js",
    "admin:cleanup-test-team:dev": "tsx src/scripts/cleanup_test_team.ts"
  },
  "keywords": [
    "ctf",
    "cybersecurity",
    "ieee",
    "techx",
    "fastify",
    "postgresql",
    "redis"
  ],
  "author": "TechX CTF Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/sensible": "^5.5.0",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
